{
  "version": 2,
  "routes": [
    {
      "src": "/api/sendReport",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      },
      "status": 204
    },
    {
      "src": "/api/sendReport",
      "dest": "backend/index.js",
      "methods": ["POST"]
    },
    {
      "src": "/",
      "dest": "/reporte_base.html"
    }
  ]
}