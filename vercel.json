{
  "version": 2,
  "routes": [
    // 1. RUTA DE PRE-VUELO (OPTIONS): Vercel debe responder con headers
    {
      "src": "/api/sendReport",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      },
      "status": 204
    },
    // 2. RUTA PRINCIPAL (POST): Vercel debe enviar esto a tu función
    {
      "src": "/api/sendReport",
      "dest": "backend/index.js",
      "methods": ["POST"]
    },
    // 3. RUTA DE LA RAÍZ: Vercel sirve el HTML base
    {
      "src": "/",
      "dest": "/reporte_base.html"
    }
  ]
}