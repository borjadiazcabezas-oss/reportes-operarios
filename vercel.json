{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/sendReport",
      "dest": "backend/index.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/",
      "dest": "/reporte_base.html"
    }
    // Vercel servirá automáticamente todos los otros archivos HTML estáticos.
  ]
}